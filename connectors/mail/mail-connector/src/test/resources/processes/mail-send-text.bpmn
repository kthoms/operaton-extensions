<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_send-text" targetNamespace="http://operaton.org/extensions/mail/test">
  <bpmn:process id="send-text" isExecutable="true" operaton:historyTimeToLive="1">
    <bpmn:startEvent id="start" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="task" />
    <bpmn:serviceTask id="task" name="Send mail">
      <bpmn:extensionElements>
        <operaton:connector>
          <operaton:connectorId>mail-send</operaton:connectorId>
          <operaton:inputOutput>
            <operaton:inputParameter name="to">${recipient}</operaton:inputParameter>
            <operaton:inputParameter name="subject">Order ${orderId}</operaton:inputParameter>
            <operaton:inputParameter name="text">Your order was received.</operaton:inputParameter>
          </operaton:inputOutput>
        </operaton:connector>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="task" targetRef="end" />
    <bpmn:endEvent id="end" />
  </bpmn:process>
</bpmn:definitions>
