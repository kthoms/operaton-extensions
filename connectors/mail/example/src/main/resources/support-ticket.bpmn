<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_support" targetNamespace="http://operaton.org/extensions/mail/example">
  <bpmn:process id="support-ticket" name="Support ticket" isExecutable="true" operaton:historyTimeToLive="30">
    <bpmn:startEvent id="MailReceived" name="Support mail received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="MailReceived" targetRef="AnswerTicket" />
    <bpmn:userTask id="AnswerTicket" name="Answer ticket" operaton:candidateGroups="agents">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="answer" label="Answer to the customer" type="string" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="AnswerTicket" targetRef="SendReply" />
    <bpmn:serviceTask id="SendReply" name="Send reply mail">
      <bpmn:extensionElements>
        <operaton:connector>
          <operaton:connectorId>mail-send</operaton:connectorId>
          <operaton:inputOutput>
            <operaton:inputParameter name="to">${mailFromAddress}</operaton:inputParameter>
            <operaton:inputParameter name="subjectTemplate">Re: {{subject}}</operaton:inputParameter>
            <operaton:inputParameter name="textTemplate">Hello,

{{answer}}

Your support desk</operaton:inputParameter>
            <operaton:inputParameter name="inReplyTo">${mailMessageId}</operaton:inputParameter>
            <operaton:inputParameter name="templateVariables">
              <operaton:map>
                <operaton:entry key="subject">${mailSubject}</operaton:entry>
                <operaton:entry key="answer">${answer}</operaton:entry>
              </operaton:map>
            </operaton:inputParameter>
          </operaton:inputOutput>
        </operaton:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SendReply" targetRef="TicketAnswered" />
    <bpmn:endEvent id="TicketAnswered" name="Ticket answered">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="support-ticket">
      <bpmndi:BPMNShape id="MailReceived_di" bpmnElement="MailReceived">
        <dc:Bounds x="172" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="150" y="145" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnswerTicket_di" bpmnElement="AnswerTicket">
        <dc:Bounds x="270" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendReply_di" bpmnElement="SendReply">
        <dc:Bounds x="430" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TicketAnswered_di" bpmnElement="TicketAnswered">
        <dc:Bounds x="592" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="145" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="120" /><di:waypoint x="270" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="120" /><di:waypoint x="430" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="530" y="120" /><di:waypoint x="592" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
