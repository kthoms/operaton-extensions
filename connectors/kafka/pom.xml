<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.operaton.extensions</groupId>
    <artifactId>operaton-extensions-parent</artifactId>
    <version>1-SNAPSHOT</version>
    <relativePath>../../parent/pom.xml</relativePath>
  </parent>

  <!-- Extension aggregator: holds the extension's version; never deployed. Metadata: extension.yml -->
  <artifactId>operaton-connector-kafka-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Operaton Kafka connector</name>
  <description>Produce to and consume from Apache Kafka in Operaton processes: send records after the engine transaction commits, start processes and correlate messages from records.</description>

  <modules>
    <module>operaton-connector-kafka</module>
    <module>operaton-connector-kafka-spring-boot-starter</module>
    <module>example</module>
  </modules>

  <properties>
    <!-- Kafka client version the artifact is built and tested with (the one managed by the Spring Boot line used by the starter and the example) -->
    <kafka-clients.version>4.2.2</kafka-clients.version>
    <jackson.version>2.22.1</jackson.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
