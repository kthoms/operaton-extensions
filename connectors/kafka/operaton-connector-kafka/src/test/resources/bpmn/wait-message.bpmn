<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" targetNamespace="http://operaton.org/extensions/test">
  <message id="paymentReceived" name="payment-received"/>
  <process id="wait-message" isExecutable="true" operaton:historyTimeToLive="1">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="catch"/>
    <intermediateCatchEvent id="catch" name="Payment received">
      <messageEventDefinition messageRef="paymentReceived"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f2" sourceRef="catch" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
