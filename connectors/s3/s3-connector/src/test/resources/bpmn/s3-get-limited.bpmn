<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_s3-get-limited" targetNamespace="http://operaton.org/extensions/s3/test">
  <bpmn:process id="s3-get-limited" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="get" name="get">
      <bpmn:extensionElements>
        <operaton:connector>
      <operaton:inputOutput>
          <operaton:inputParameter name="key">${objectKey}</operaton:inputParameter>
          <operaton:inputParameter name="maxSize">${maxSize}</operaton:inputParameter>
          <operaton:outputParameter name="text">${download.text}</operaton:outputParameter>
        </operaton:inputOutput>
          <operaton:connectorId>s3-get</operaton:connectorId>
        </operaton:connector>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="get"/>
    <bpmn:sequenceFlow id="f1" sourceRef="get" targetRef="end"/>
    <bpmn:endEvent id="end"/>
  </bpmn:process>
</bpmn:definitions>
