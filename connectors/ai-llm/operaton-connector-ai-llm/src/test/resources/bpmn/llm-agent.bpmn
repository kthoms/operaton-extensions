<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://operaton.org/extensions/test">
  <bpmn:process id="llm-agent" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="start"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="answer"/>
    <bpmn:serviceTask id="answer" name="Answer customer">
      <bpmn:extensionElements>
        <operaton:connector>
          <operaton:connectorId>llm-agent</operaton:connectorId>
          <operaton:inputOutput>
            <operaton:inputParameter name="userPrompt">{{question}}</operaton:inputParameter>
            <operaton:inputParameter name="tools">order_status</operaton:inputParameter>
            <operaton:inputParameter name="readableVariables">
              <operaton:list>
                <operaton:value>orderId</operaton:value>
              </operaton:list>
            </operaton:inputParameter>
            <operaton:inputParameter name="maxIterations">3</operaton:inputParameter>
            <operaton:inputParameter name="resultVariable">answer</operaton:inputParameter>
            <operaton:outputParameter name="agentIterations">${iterations}</operaton:outputParameter>
            <operaton:outputParameter name="agentToolCalls">${toolCalls}</operaton:outputParameter>
          </operaton:inputOutput>
        </operaton:connector>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="answer" targetRef="wait"/>
    <bpmn:userTask id="wait" name="Check answer"/>
  </bpmn:process>
</bpmn:definitions>
