<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  targetNamespace="http://operaton.org/extensions/typed-variables-assertions-test">
  <bpmn:process id="assertions-test" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="start"/>
    <bpmn:subProcess id="sub">
      <bpmn:extensionElements>
        <operaton:executionListener event="start" class="org.operaton.extensions.plugin.typedvariables.test.AssertionsTest$LocalListener"/>
      </bpmn:extensionElements>
      <bpmn:startEvent id="subStart"/>
      <bpmn:userTask id="wait" name="Wait"/>
      <bpmn:endEvent id="subEnd"/>
      <bpmn:sequenceFlow id="s1" sourceRef="subStart" targetRef="wait"/>
      <bpmn:sequenceFlow id="s2" sourceRef="wait" targetRef="subEnd"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sub"/>
    <bpmn:sequenceFlow id="f2" sourceRef="sub" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
