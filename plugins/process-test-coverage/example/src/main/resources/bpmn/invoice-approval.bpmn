<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="Definitions_invoice" targetNamespace="http://operaton.org/extensions/process-test-coverage/example">
  <bpmn:process id="invoice-approval" name="Invoice approval" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="start" name="Invoice received"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check"/>
    <bpmn:serviceTask id="check" name="Check invoice" operaton:class="org.operaton.extensions.plugin.processtestcoverage.example.CheckInvoiceDelegate"/>
    <bpmn:sequenceFlow id="f2" sourceRef="check" targetRef="gwApproval"/>
    <bpmn:exclusiveGateway id="gwApproval" name="Approval needed?" default="fNoApproval"/>
    <bpmn:sequenceFlow id="fNoApproval" name="no" sourceRef="gwApproval" targetRef="book"/>
    <bpmn:sequenceFlow id="fNeedsApproval" name="yes" sourceRef="gwApproval" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${needsApproval}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="approve" name="Approve invoice" operaton:candidateGroups="accounting"/>
    <bpmn:sequenceFlow id="f3" sourceRef="approve" targetRef="gwApproved"/>
    <bpmn:exclusiveGateway id="gwApproved" name="Approved?" default="fRejected"/>
    <bpmn:sequenceFlow id="fApproved" name="yes" sourceRef="gwApproved" targetRef="book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fRejected" name="no" sourceRef="gwApproved" targetRef="endRejected"/>
    <bpmn:serviceTask id="book" name="Book invoice" operaton:class="org.operaton.extensions.plugin.processtestcoverage.example.BookInvoiceDelegate"/>
    <bpmn:sequenceFlow id="f4" sourceRef="book" targetRef="endBooked"/>
    <bpmn:endEvent id="endBooked" name="Invoice booked"/>
    <bpmn:endEvent id="endRejected" name="Invoice rejected"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_invoice">
    <bpmndi:BPMNPlane id="Plane_invoice" bpmnElement="invoice-approval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="129" y="225" width="82" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_di" bpmnElement="check"><dc:Bounds x="240" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwApproval_di" bpmnElement="gwApproval" isMarkerVisible="true">
        <dc:Bounds x="390" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="372" y="232" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="500" y="40" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwApproved_di" bpmnElement="gwApproved" isMarkerVisible="true">
        <dc:Bounds x="680" y="55" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="682" y="25" width="46" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="book_di" bpmnElement="book"><dc:Bounds x="780" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endBooked_di" bpmnElement="endBooked">
        <dc:Bounds x="952" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="932" y="225" width="76" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="952" y="62" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="105" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="188" y="200"/><di:waypoint x="240" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="340" y="200"/><di:waypoint x="390" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNoApproval_di" bpmnElement="fNoApproval">
        <di:waypoint x="440" y="200"/><di:waypoint x="780" y="200"/>
        <bpmndi:BPMNLabel><dc:Bounds x="602" y="182" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNeedsApproval_di" bpmnElement="fNeedsApproval">
        <di:waypoint x="415" y="175"/><di:waypoint x="415" y="80"/><di:waypoint x="500" y="80"/>
        <bpmndi:BPMNLabel><dc:Bounds x="421" y="120" width="18" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="600" y="80"/><di:waypoint x="680" y="80"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fApproved_di" bpmnElement="fApproved">
        <di:waypoint x="705" y="105"/><di:waypoint x="705" y="130"/><di:waypoint x="830" y="130"/><di:waypoint x="830" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="715" y="112" width="18" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fRejected_di" bpmnElement="fRejected">
        <di:waypoint x="730" y="80"/><di:waypoint x="952" y="80"/>
        <bpmndi:BPMNLabel><dc:Bounds x="835" y="62" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="880" y="200"/><di:waypoint x="952" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
