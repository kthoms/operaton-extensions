<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" targetNamespace="http://operaton.org/extensions/test" id="d3">
  <bpmn:process id="ptc-link" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="start"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="throwLink"/>
    <bpmn:intermediateThrowEvent id="throwLink"><bpmn:linkEventDefinition name="jump"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="catchLink"><bpmn:linkEventDefinition name="jump"/></bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f2" sourceRef="catchLink" targetRef="end"/>
    <bpmn:endEvent id="end"/>
  </bpmn:process>
</bpmn:definitions>
