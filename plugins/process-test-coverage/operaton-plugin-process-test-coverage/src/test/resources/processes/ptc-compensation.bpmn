<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" targetNamespace="http://operaton.org/extensions/test" id="d4">
  <bpmn:process id="ptc-compensation" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="start"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="book"/>
    <bpmn:serviceTask id="book" operaton:expression="${true}"/>
    <bpmn:boundaryEvent id="compBoundary" attachedToRef="book"><bpmn:compensateEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="cancel" isForCompensation="true" operaton:expression="${true}"/>
    <bpmn:sequenceFlow id="f2" sourceRef="book" targetRef="undo"/>
    <bpmn:intermediateThrowEvent id="undo"><bpmn:compensateEventDefinition waitForCompletion="true"/></bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="f3" sourceRef="undo" targetRef="end"/>
    <bpmn:endEvent id="end"/>
    <bpmn:association id="a1" associationDirection="One" sourceRef="compBoundary" targetRef="cancel"/>
  </bpmn:process>
</bpmn:definitions>
