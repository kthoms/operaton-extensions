<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.operaton.extensions</groupId>
    <artifactId>operaton-extensions-parent</artifactId>
    <version>1-SNAPSHOT</version>
    <relativePath>../../parent/pom.xml</relativePath>
  </parent>

  <!-- Extension aggregator: holds the extension's version; never deployed. Metadata: extension.yml -->
  <artifactId>operaton-plugin-micrometer-metrics-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Operaton Micrometer Metrics Plugin</name>
  <description>Exposes Operaton engine metrics, job backlog, incidents and process instance counters through Micrometer.</description>

  <modules>
    <module>operaton-plugin-micrometer-metrics</module>
    <module>operaton-plugin-micrometer-metrics-spring-boot-starter</module>
    <module>example</module>
  </modules>

  <properties>
    <!-- Micrometer the plugin is compiled against (the one of Spring Boot 4.1); the host application provides the runtime -->
    <micrometer.version>1.17.3</micrometer.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
