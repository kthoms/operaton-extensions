<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="Definitions_order_fulfillment" targetNamespace="http://operaton.org/extensions/micrometer-metrics/example">
  <bpmn:process id="order-fulfillment" name="Order fulfillment" isExecutable="true" operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="received" name="Order received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="received" targetRef="validate-order"/>
    <bpmn:serviceTask id="validate-order" name="Validate order" operaton:asyncBefore="true" operaton:delegateExpression="${validateOrderDelegate}">
      <bpmn:extensionElements>
        <operaton:failedJobRetryTimeCycle>R1/PT0S</operaton:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="validate-order" targetRef="large-order"/>
    <bpmn:exclusiveGateway id="large-order" name="Large order?" default="f-small">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f-large</bpmn:outgoing>
      <bpmn:outgoing>f-small</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f-large" name="yes (amount above 1000)" sourceRef="large-order" targetRef="approve-order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${amount &gt; 1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-small" name="no" sourceRef="large-order" targetRef="ship-order"/>
    <bpmn:userTask id="approve-order" name="Approve order" operaton:candidateGroups="managers">
      <bpmn:incoming>f-large</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f3" sourceRef="approve-order" targetRef="ship-order"/>
    <bpmn:serviceTask id="ship-order" name="Ship order" operaton:delegateExpression="${shipOrderDelegate}">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f-small</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f4" sourceRef="ship-order" targetRef="shipped"/>
    <bpmn:endEvent id="shipped" name="Order shipped">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="received_di" bpmnElement="received"><dc:Bounds x="152" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate-order_di" bpmnElement="validate-order"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="large-order_di" bpmnElement="large-order"><dc:Bounds x="395" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve-order_di" bpmnElement="approve-order"><dc:Bounds x="500" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship-order_di" bpmnElement="ship-order"><dc:Bounds x="660" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipped_di" bpmnElement="shipped"><dc:Bounds x="822" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="188" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="340" y="120"/><di:waypoint x="395" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-large_di" bpmnElement="f-large"><di:waypoint x="445" y="120"/><di:waypoint x="500" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="600" y="120"/><di:waypoint x="660" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-small_di" bpmnElement="f-small"><di:waypoint x="420" y="145"/><di:waypoint x="420" y="230"/><di:waypoint x="710" y="230"/><di:waypoint x="710" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="760" y="120"/><di:waypoint x="822" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
