{
  "uid": "operaton-metrics",
  "title": "Operaton",
  "tags": [
    "operaton"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Process instances started per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (process_definition_key) (increase(operaton_process_instances_started_total[1m]))",
          "legendFormat": "{{process_definition_key}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Process instances ended per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (process_definition_key, state) (increase(operaton_process_instances_ended_total[1m]))",
          "legendFormat": "{{process_definition_key}} {{state}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Running process instances",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (process_definition_key) (operaton_process_instances_running)",
          "legendFormat": "{{process_definition_key}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(operaton_jobs_due)",
          "legendFormat": "due"
        },
        {
          "refId": "B",
          "expr": "sum(operaton_jobs_failed)",
          "legendFormat": "failed (no retries)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open incidents by type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (incident_type) (operaton_incidents_open)",
          "legendFormat": "{{incident_type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Incidents raised / resolved per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(operaton_incidents_raised_total[1m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(increase(operaton_incidents_resolved_total[1m]))",
          "legendFormat": "resolved"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Activity instances started per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(operaton_engine_activity_instance_start_total[1m]))",
          "legendFormat": "activity instances"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job executions per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(operaton_engine_job_successful_total[1m]))",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "expr": "sum(rate(operaton_engine_job_failed_total[1m]))",
          "legendFormat": "failed"
        }
      ]
    }
  ]
}