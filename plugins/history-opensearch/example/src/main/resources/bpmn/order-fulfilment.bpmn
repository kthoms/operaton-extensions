<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_orders" targetNamespace="http://operaton.org/examples/history-opensearch">
  <bpmn:process id="order-fulfilment" name="Order fulfilment" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="order-received" name="Order received">
      <bpmn:outgoing>flow-to-check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="check-stock" name="Check stock" operaton:delegateExpression="${stockCheck}">
      <bpmn:incoming>flow-to-check</bpmn:incoming>
      <bpmn:outgoing>flow-to-stock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="in-stock" name="In stock?" default="flow-out-of-stock">
      <bpmn:incoming>flow-to-stock</bpmn:incoming>
      <bpmn:outgoing>flow-in-stock</bpmn:outgoing>
      <bpmn:outgoing>flow-out-of-stock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pack-order" name="Pack order" operaton:candidateGroups="warehouse">
      <bpmn:incoming>flow-in-stock</bpmn:incoming>
      <bpmn:outgoing>flow-packed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ship-order" name="Ship order" operaton:delegateExpression="${shipOrder}">
      <bpmn:incoming>flow-packed</bpmn:incoming>
      <bpmn:outgoing>flow-shipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="order-shipped" name="Order shipped">
      <bpmn:incoming>flow-shipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="arrange-backorder" name="Arrange backorder" operaton:candidateGroups="purchasing">
      <bpmn:incoming>flow-out-of-stock</bpmn:incoming>
      <bpmn:outgoing>flow-backordered</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="order-backordered" name="Order backordered">
      <bpmn:incoming>flow-backordered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-to-check" sourceRef="order-received" targetRef="check-stock" />
    <bpmn:sequenceFlow id="flow-to-stock" sourceRef="check-stock" targetRef="in-stock" />
    <bpmn:sequenceFlow id="flow-in-stock" name="In stock" sourceRef="in-stock" targetRef="pack-order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inStock == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-out-of-stock" name="Out of stock" sourceRef="in-stock" targetRef="arrange-backorder" />
    <bpmn:sequenceFlow id="flow-packed" sourceRef="pack-order" targetRef="ship-order" />
    <bpmn:sequenceFlow id="flow-shipped" sourceRef="ship-order" targetRef="order-shipped" />
    <bpmn:sequenceFlow id="flow-backordered" sourceRef="arrange-backorder" targetRef="order-backordered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-fulfilment">
      <bpmndi:BPMNShape id="order-received_di" bpmnElement="order-received">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="133" y="145" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check-stock_di" bpmnElement="check-stock">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="in-stock_di" bpmnElement="in-stock" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="396" y="65" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pack-order_di" bpmnElement="pack-order">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship-order_di" bpmnElement="ship-order">
        <dc:Bounds x="660" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="order-shipped_di" bpmnElement="order-shipped">
        <dc:Bounds x="822" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="804" y="145" width="73" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrange-backorder_di" bpmnElement="arrange-backorder">
        <dc:Bounds x="500" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="order-backordered_di" bpmnElement="order-backordered">
        <dc:Bounds x="662" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="641" y="305" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-to-check_di" bpmnElement="flow-to-check">
        <di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-stock_di" bpmnElement="flow-to-stock">
        <di:waypoint x="340" y="120" /><di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-in-stock_di" bpmnElement="flow-in-stock">
        <di:waypoint x="445" y="120" /><di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="451" y="102" width="43" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-out-of-stock_di" bpmnElement="flow-out-of-stock">
        <di:waypoint x="420" y="145" /><di:waypoint x="420" y="280" /><di:waypoint x="500" y="280" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="200" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-packed_di" bpmnElement="flow-packed">
        <di:waypoint x="600" y="120" /><di:waypoint x="660" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-shipped_di" bpmnElement="flow-shipped">
        <di:waypoint x="760" y="120" /><di:waypoint x="822" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-backordered_di" bpmnElement="flow-backordered">
        <di:waypoint x="600" y="280" /><di:waypoint x="662" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
