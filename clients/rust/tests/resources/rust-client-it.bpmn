<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
    id="Definitions_it" targetNamespace="http://operaton.org/extensions/client-rust-it">
  <bpmn:process id="rust-client-it" name="Rust client integration test" isExecutable="true"
      operaton:historyTimeToLive="P1D">
    <bpmn:startEvent id="started" name="Started">
      <bpmn:outgoing>flowToWork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="doWork" name="Do work" operaton:type="external"
        operaton:topic="${topic}">
      <bpmn:incoming>flowToWork</bpmn:incoming>
      <bpmn:outgoing>flowToDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="workRejectedBoundary" name="Work rejected" attachedToRef="doWork">
      <bpmn:outgoing>flowToRejected</bpmn:outgoing>
      <bpmn:errorEventDefinition id="rejectedDef" errorRef="Error_it"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="done" name="Done">
      <bpmn:incoming>flowToDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="rejected" name="Rejected">
      <bpmn:incoming>flowToRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flowToWork" sourceRef="started" targetRef="doWork"/>
    <bpmn:sequenceFlow id="flowToDone" name="accepted" sourceRef="doWork" targetRef="done"/>
    <bpmn:sequenceFlow id="flowToRejected" name="rejected" sourceRef="workRejectedBoundary"
        targetRef="rejected"/>
  </bpmn:process>
  <bpmn:error id="Error_it" name="Work rejected" errorCode="IT_ERROR"/>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="rust-client-it">
      <bpmndi:BPMNShape id="started_di" bpmnElement="started">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doWork_di" bpmnElement="doWork">
        <dc:Bounds x="250" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="432" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected">
        <dc:Bounds x="432" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="workRejectedBoundary_di" bpmnElement="workRejectedBoundary">
        <dc:Bounds x="292" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flowToWork_di" bpmnElement="flowToWork">
        <di:waypoint x="188" y="120"/><di:waypoint x="250" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowToDone_di" bpmnElement="flowToDone">
        <di:waypoint x="350" y="120"/><di:waypoint x="432" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowToRejected_di" bpmnElement="flowToRejected">
        <di:waypoint x="310" y="178"/><di:waypoint x="310" y="240"/><di:waypoint x="432" y="240"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
